version: "3.9"
services:
  postgres:
    image: "postgres:17.0-alpine3.20"
    container_name: database-container-name
    restart: unless-stopped
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: DATABASE_NAME
      POSTGRES_USER: DATABASE_USER
      POSTGRES_PASSWORD: *******************

  rest-api:
    build:
      context: ./
      target: development
    command: npm run start:dev
    volumes:
      - /usr/src/app/node_modules/
    ports:
      - "9229:9229"
    depends_on:
    - postgres
    environment:
      NODE_ENV: development
      DATABASE_URL: "PROVIDER://DATABASE_USER:DATABASE_PASSWORD@HOST:PORT/DATABASE_NAME?schema=SCHEMA_NAME"
      TOKEN_SECRET: *******************
      EXPIRES_IN: 3600
    links:
      - postgres
