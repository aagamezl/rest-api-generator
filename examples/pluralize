#!/bin/bash

function pluralize() {
    local word="$1"

    # Map of irregular singular to plural forms
    declare -A irregular_patterns=(
        ["move"]="moves"
        ["foot"]="feet"
        ["goose"]="geese"
        ["sex"]="sexes"
        ["child"]="children"
        ["man"]="men"
        ["tooth"]="teeth"
        ["person"]="people"
        ["class"]="classes" # Ensure "class" is correctly pluralized
    )

    # Map of regular patterns for pluralization
    declare -A plural_patterns=(
        ["(quiz)$"]="\\1zes"
        ["^(ox)$"]="\\1en"
        ["([m|l])ouse$"]="\\1ice"
        ["(matr|vert|ind)ix|ex$"]="\\1ices"
        ["(x|ch|ss|sh)$"]="\\1es"
        ["([^aeiouy]|qu)y$"]="\\1ies"
        ["(hive)$"]="\\1s"
        ["(?:([^f])fe|([lr])f)$"]="\\1\\2ves"
        ["(shea|lea|loa|thie)f$"]="\\1ves"
        ["sis$"]="ses"
        ["([ti])um$"]="\\1a"
        ["(tomat|potat|ech|her|vet)o$"]="\\1oes"
        ["(bu)s$"]="\\1ses"
        ["(alias)$"]="\\1es"
        ["(octop)us$"]="\\1i"
        ["(ax|test)is$"]="\\1es"
        ["(us)$"]="\\1es"
        ["([^s]+)$"]="\\1s" # Catch-all for simple singular forms
    )

    # Uncountable nouns list
    local -a uncountable=(
        aircraft audio bison cattle chassis cod compensation coreopsis data deer
        education emoji equipment evidence feedback firmware fish furniture gold
        hardware hovercraft information jedi kin knowledge love metadata money moose
        news nutrition offspring pike plankton pokemon police rain recommended related
        rice salmon series sheep shrimp software spacecraft species sugar swine traffic
        trout tuna wheat wood you
    )

    # Check if the word is uncountable
    for uncountable_word in "${uncountable[@]}"; do
        if [[ "${word,,}" == "$uncountable_word" ]]; then
            echo "$word"
            return
        fi
    done

    # Check for irregular singular forms
    for singular in "${!irregular_patterns[@]}"; do
        local pattern="^${singular}$"
        if [[ "$word" =~ $pattern ]]; then
            echo "${irregular_patterns[$singular]}"
            return
        fi
    done

    # Check for general patterns
    for reg in "${!plural_patterns[@]}"; do
        if [[ "$word" =~ $reg ]]; then
            echo "$(echo "$word" | sed -E "s/$reg/${plural_patterns[$reg]}/")"
            return
        fi
    done

    # Return the original word if no patterns match
    echo "$word"
}

