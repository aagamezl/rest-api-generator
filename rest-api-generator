#!/bin/bash

# Reset and color codes for styling output
RESET='\033[0m' # Color Off
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'

#--------------------------- START UTILITY FUNCTION ----------------------------
# Function to create a directory if it doesn’t exist
function create_directory() {
  local path="$1"

  if [ ! -d "$path" ]; then
    mkdir -p "$path"

    echo -e "${GREEN}Directory '$path' created.${RESET}"
  else
    echo -e "${YELLOW}Directory '$path' already exists.${RESET}"
  fi
}

# Function to create a file if it doesn’t exist
function create_file() {
  local filename="$1"

  if [ -f "$filename" ]; then
    echo -e "${YELLOW}File '$filename' already exists. Skipping.${RESET}"

    return 1 # File exists, return false (1 in Bash)
  fi

  touch "$filename"

  echo -e "${GREEN}File '$filename' created.${RESET}"

  return 0 # File does not exist, return true (0 in Bash)
}

function capitalize() {
  echo "${1^}"
}

function pluralize() {
  local word="$1"

  # List of uncountable nouns
  local -a uncountable=(
    aircraft audio bison cattle chassis cod compensation coreopsis data deer
    education emoji equipment evidence feedback firmware fish furniture gold
    hardware hovercraft information jedi kin knowledge love metadata money moose
    news nutrition offspring pike plankton pokemon police rain recommended related
    rice salmon series sheep shrimp software spacecraft species sugar swine traffic
    trout tuna wheat wood you
  )

  # Map of irregular singular to plural forms
  declare -A irregular_patterns=(
    ["move"]="moves"
    ["foot"]="feet"
    ["goose"]="geese"
    ["sex"]="sexes"
    ["child"]="children"
    ["man"]="men"
    ["tooth"]="teeth"
    ["person"]="people"
  )

  # Map of regular patterns for pluralization
  declare -A plural_patterns=(
    ["(quiz)$"]="\\1zes"
    ["^(ox)$"]="\\1en"
    ["([m|l])ouse$"]="\\1ice"
    ["(matr|vert|ind)ix|ex$"]="\\1ices"
    ["(x|ch|ss|sh)$"]="\\1es"
    ["([^aeiouy]|qu)y$"]="\\1ies"
    ["(hive)$"]="\\1s"
    ["(?:([^f])fe|([lr])f)$"]="\\1\\2ves"
    ["(shea|lea|loa|thie)f$"]="\\1ves"
    ["sis$"]="ses"
    ["([ti])um$"]="\\1a"
    ["(tomat|potat|ech|her|vet)o$"]="\\1oes"
    ["(bu)s$"]="\\1ses"
    ["(alias)$"]="\\1es"
    ["(octop)us$"]="\\1i"
    ["(ax|test)is$"]="\\1es"
    ["(us)$"]="\\1es"
    ["([^s]+)$"]="\\1s"
  )

  # Check if the word is uncountable
  for uncountable_word in "${uncountable[@]}"; do
    if [[ "${word,,}" == "$uncountable_word" ]]; then
      echo "$word"
      return
    fi
  done

  # Check for irregular singular forms
  for singular in "${!irregular_patterns[@]}"; do
    local pattern="^${singular}$"
    if [[ "$word" =~ $pattern ]]; then
      echo "${irregular_patterns[$singular]}"
      return
    fi
  done

  # Check for matches using regular patterns
  for reg in "${!plural_patterns[@]}"; do
    if [[ "$word" =~ $reg ]]; then
      echo "$(echo "$word" | sed -E "s/$reg/${plural_patterns[$reg]}/")"
      return
    fi
  done

  # Return the original word if no patterns match
  echo "$word"
}

function singularize() {
  local word="$1"

  # Map of regular patterns for singularization
  declare -A singular_patterns=(
    ["(quiz)zes$"]="\\1"
    ["(matr)ices$"]="\\1ix"
    ["(vert|ind)ices$"]="\\1ex"
    ["^(ox)en$"]="\\1"
    ["(alias)es$"]="\\1"
    ["(octop|vir)i$"]="\\1us"
    ["(cris|ax|test)es$"]="\\1is"
    ["(shoe)s$"]="\\1"
    ["(o)es$"]="\\1"
    ["(bus)es$"]="\\1"
    ["([m|l])ice$"]="\\1ouse"
    ["(x|ch|ss|sh)es$"]="\\1"
    ["(m)ovies$"]="\\1ovie"
    ["(s)eries$"]="\\1eries"
    ["([^aeiouy]|qu)ies$"]="\\1y"
    ["([lr])ves$"]="\\1f"
    ["(tive)s$"]="\\1"
    ["(hive)s$"]="\\1"
    ["(li|wi|kni)ves$"]="\\1fe"
    ["(shea|loa|lea|thie)ves$"]="\\1f"
    ["(^analy)ses$"]="\\1sis"
    ["((a)naly|(b)a|(d)iagno|(p)arenthe|(p)rogno|(s)ynop|(t)he)ses$"]="\\1\\2sis"
    ["([ti])a$"]="\\1um"
    ["(n)ews$"]="\\1ews"
    ["(h|bl)ouses$"]="\\1ouse"
    ["(corpse)s$"]="\\1"
    ["(us)es$"]="\\1"
    ["(.*)s$"]="\\1" # Catch-all for simple plural forms
  )

  # Map of irregular plural to singular forms
  declare -A irregular_patterns=(
    ["moves"]="move"
    ["feet"]="foot"
    ["geese"]="goose"
    ["sexes"]="sex"
    ["children"]="child"
    ["men"]="man"
    ["teeth"]="tooth"
    ["people"]="person"
    ["classes"]="class" # Special case for "classes"
  )

  # Check for irregular forms
  for plural in "${!irregular_patterns[@]}"; do
    local pattern="^${plural}$"
    if [[ "$word" =~ $pattern ]]; then
      echo "${irregular_patterns[$plural]}"
      return
    fi
  done

  # Check for general patterns
  for reg in "${!singular_patterns[@]}"; do
    if [[ "$word" =~ $reg ]]; then
      echo "$(echo "$word" | sed -E "s/$reg/${singular_patterns[$reg]}/")"
      return
    fi
  done

  # Return the original word if no patterns match
  echo "$word"
}

# Function to normalize input by converting to lowercase and replacing separators with spaces
function normalize_input() {
  local input=$1
  # Add spaces between camelCase or PascalCase words and convert separators to spaces
  echo "$input" | sed -E 's/([a-z])([A-Z])/\1 \2/g' | tr '[:upper:]' '[:lower:]' | tr -s ' _-' ' '
}

# Function to transform a string to PascalCase
to_pascal_case() {
  local input=$(normalize_input "$1")
  echo "$input" | awk '{for(i=1; i<=NF; i++) $i=toupper(substr($i,1,1)) substr($i,2)}1' OFS=''
}

# Function to transform a string to camelCase
function to_camel_case() {
  local pascal_case=$(to_pascal_case "$1")
  local firstChar=$(echo "${pascal_case:0:1}" | tr '[:upper:]' '[:lower:]')
  local rest="${pascal_case:1}"

  echo "$firstChar$rest"
}

# Function to transform a string to snake_case
function to_snake_case() {
  local input=$(normalize_input "$1")
  echo "$input" | tr ' ' '_'
}

# Function to transform a string to kebab-case
function to_kebab_case() {
  local input=$(normalize_input "$1")
  echo "$input" | tr ' ' '-'
}
